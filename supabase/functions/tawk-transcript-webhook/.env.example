# Copy to an untracked local file before passing it to `supabase secrets set`.
# Never commit real values.
TAWK_WEBHOOK_SECRET=
TAWK_PROPERTY_ID=
# Same >=32-character server-only secret as the Next.js tawk identity route.
TAWK_WEBHOOK_IDENTITY_SECRET=
# Dedicated >=32-character token for the scheduled incomplete-delivery retry.
SUPPORT_TRANSCRIPT_RETRY_SECRET=

VAPID_SUBJECT=mailto:support@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM_NAME=Monalyz Support
TRANSACTIONAL_EMAIL_FROM_EMAIL=support@example.com
TRANSACTIONAL_EMAIL_REPLY_TO=support@example.com

# Must be a same-origin absolute path consumed by the PWA service worker.
SUPPORT_PUSH_URL=/myaccount
