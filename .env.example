NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_APP_ORIGIN=http://127.0.0.1:3000
APP_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_CANONICAL_ORIGIN=http://127.0.0.1:3000
# Jeton fourni par Google Search Console après ajout de la propriété de domaine.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Origines HTTPS supplémentaires de confiance, séparées par des virgules.
APP_ALLOWED_ORIGINS=
NEXT_PUBLIC_SUPPORT_EMAIL=support@monalyz.com

# Support tawk.to (identifiants et secret disponibles uniquement côté serveur).
TAWK_PROPERTY_ID=
# Un widget Tawk distinct par langue Monalyz, chacun configuré dans sa langue.
# Exemple : {"default":"widget-fr","fr":"widget-fr","en":"widget-en","de":"widget-de","es":"widget-es","it":"widget-it","nl":"widget-nl"}
TAWK_WIDGET_IDS=
TAWK_API_KEY=
# Secret applicatif aléatoire (32+ caractères), identique dans Next et l'Edge Function.
TAWK_WEBHOOK_IDENTITY_SECRET=

# Clé publique Web Push, exposée aux clients authentifiés par une route serveur.
VAPID_PUBLIC_KEY=

# E-mails métier : choisissez exactement un fournisseur.
TRANSACTIONAL_EMAIL_PROVIDER=resend
TRANSACTIONAL_EMAIL_FROM_EMAIL=support@monalyz.com
TRANSACTIONAL_EMAIL_FROM_NAME=Monalyz
TRANSACTIONAL_EMAIL_REPLY_TO=support@monalyz.com
TRANSACTIONAL_EMAIL_ASSET_BASE_URL=http://127.0.0.1:3000
RESEND_API_KEY=re_replace_me
SEND_EMAIL_HOOK_SECRET=v1,whsec_replace_me
# Pour Brevo, remplacez le fournisseur ci-dessus et utilisez une clé API REST.
# BREVO_API_KEY=xkeysib-replace-me

# Client serveur privilégié requis par le worker d'outbox. Jamais NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Secret aléatoire 32+ caractères pour la reprise et le nettoyage résiduel
# de l'ancien UUID après suppression immédiate de l'identité Auth.
CLIENT_PURGE_SWEEP_SECRET=
# Secret distinct aléatoire 32+ caractères pour rendre les previews idempotentes.
CLIENT_PURGE_CHALLENGE_SECRET=
# Compatibilité avec les anciennes clés Supabase :
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Monalyz does not use a bank API and does not connect to any bank.
# Never expose a Supabase service-role key to the browser.
