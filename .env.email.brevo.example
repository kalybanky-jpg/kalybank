# Copiez ce fichier vers .env.email.brevo.local, qui reste hors Git.
# Le script configure le SMTP et les modèles Supabase Auth du projet indiqué.
SUPABASE_PROJECT_REF=qljqldhvbakornnpalua
SUPABASE_ACCESS_TOKEN=your-management-access-token

AUTH_SMTP_FROM_EMAIL=support@monalyz.com
AUTH_SMTP_SENDER_NAME=Monalyz
AUTH_EMAIL_RATE_LIMIT_PER_HOUR=30
AUTH_SMTP_MAX_FREQUENCY_SECONDS=60

# Utilisez le login SMTP et une clé SMTP Brevo, jamais une clé API Brevo.
BREVO_SMTP_LOGIN=your-brevo-smtp-login
BREVO_SMTP_KEY=xsmtpsib-replace-me

# L'envoi métier utilise l'API REST Brevo et donc une clé API distincte.
TRANSACTIONAL_EMAIL_PROVIDER=brevo
TRANSACTIONAL_EMAIL_FROM_EMAIL=support@monalyz.com
TRANSACTIONAL_EMAIL_FROM_NAME=Monalyz
TRANSACTIONAL_EMAIL_REPLY_TO=support@monalyz.com
BREVO_API_KEY=xkeysib-replace_me

# Requis uniquement côté serveur pour réclamer et terminer les jobs d'outbox.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
