# Copiez ce fichier vers .env.email.resend.local, qui reste hors Git.
# Le script configure le SMTP et les modèles Supabase Auth du projet indiqué.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your-management-access-token

AUTH_SMTP_FROM_EMAIL=no-reply@auth.your-domain.example
AUTH_SMTP_SENDER_NAME=KALY
AUTH_EMAIL_RATE_LIMIT_PER_HOUR=30
AUTH_SMTP_MAX_FREQUENCY_SECONDS=60

# Resend SMTP utilise une clé API comme mot de passe et le login fixe "resend".
RESEND_API_KEY=re_replace_me
