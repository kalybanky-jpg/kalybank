{
  "name": "monalyz",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.9.0",
    "bun": "1.3.14"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:netlify": "bun install --frozen-lockfile --cpu=x64 --os=linux && next build && tsx scripts/verify-netlify-build.ts",
    "start": "next start",
    "brand:build": "tsx scripts/generate-brand-assets.ts",
    "brand:check": "tsx scripts/generate-brand-assets.ts --check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "test:db": "supabase test db supabase/tests --local",
    "test:client-purge:integration": "tsx scripts/test-client-purge-integration.ts",
    "supabase:link": "supabase link --project-ref qljqldhvbakornnpalua",
    "db:deploy:check": "supabase db push --linked --dry-run",
    "db:deploy": "supabase db push --linked",
    "db:snapshot": "tsx scripts/update-database-snapshot.ts",
    "db:types": "tsx scripts/sync-database-types.ts",
    "db:types:check": "tsx scripts/sync-database-types.ts --check",
    "auth:email:check:resend": "tsx --env-file=.env scripts/configure-supabase-auth-email.ts resend --dry-run",
    "auth:email:configure:resend": "tsx --env-file=.env scripts/configure-supabase-auth-email.ts resend",
    "auth:email:check:brevo": "tsx --env-file=.env.email.brevo.local scripts/configure-supabase-auth-email.ts brevo --dry-run",
    "auth:email:configure:brevo": "tsx --env-file=.env.email.brevo.local scripts/configure-supabase-auth-email.ts brevo",
    "demo:provision": "tsx scripts/provision-demo-accounts.ts",
    "documents:reissue:check": "tsx --env-file=.env scripts/reissue-localized-official-documents.ts",
    "documents:reissue:apply": "tsx --env-file=.env scripts/reissue-localized-official-documents.ts --apply",
    "support:keys": "tsx scripts/generate-vapid-keys.ts",
    "support:vapid": "tsx scripts/generate-vapid-keys.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.5.7",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.9",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "16.2.12",
    "pdf-lib": "^1.17.1",
    "postcss": "8.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "0.35.0",
    "standardwebhooks": "1.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@netlify/functions": "5.3.0",
    "@netlify/plugin-nextjs": "5.15.13",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.12",
    "supabase": "2.110.0",
    "tailwindcss": "4.1.11",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "postcss": "8.5.23",
    "sharp": "0.35.0"
  },
  "patchedDependencies": {
    "minimatch@3.1.5": "patches/minimatch@3.1.5.patch"
  }
}
